{
  "env": {
    "OPENAI_MODEL": "happy/kimi-k3",
    "ANTHROPIC_CUSTOM_MODEL_OPTIONS": "[{\"value\":\"happy/glm-5.3\",\"label\":\"happy/glm-5.3\",\"description\":\"Served by proxy (happy/glm-5.3)\"},{\"value\":\"happy/kimi-k3\",\"label\":\"happy/kimi-k3\",\"description\":\"Served by proxy (happy/kimi-k3)\"},{\"value\":\"happy/qwen-3.8-fast\",\"label\":\"happy/qwen-3.8-fast\",\"description\":\"Served by proxy (happy/qwen-3.8-fast)\"}]"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allowBypassPermissionsMode": true
  },
  "model": "happy/kimi-k3",
  "availableModels": [
    "happy/glm-5.3",
    "happy/kimi-k3",
    "happy/qwen-3.8-fast"
  ],
  "alwaysThinkingEnabled": true,
  "modelLimits": {
    "happy/glm-5.3": {
      "contextWindow": 1048576,
      "maxOutputTokens": 16384
