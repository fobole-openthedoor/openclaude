# Official OpenClaude — isolated from ~/.bashrc OPENAI_BASE_URL (strix/cige).
export OPENCLAUDE_CONFIG_DIR="$HOME/.audncode-platform"
# Local fork (Gitlawb/openclaude @ v0.30.0 + historical reasoning replay).
export OPENCLAUDE_FORK_ROOT="${OPENCLAUDE_FORK_ROOT:-$HOME/openclaude}"
export OPENCLAUDE_BIN="${OPENCLAUDE_BIN:-$OPENCLAUDE_FORK_ROOT/bin/openclaude}"
# Leave unset so `openclaude update` uses forgejo, then github, then origin.
# export OPENCLAUDE_GIT_REMOTE=forgejo
export OPENCLAUDE_GIT_BRANCH="${OPENCLAUDE_GIT_BRANCH:-preserve-reasoning-history}"
# Background npm updater stays off; `openclaude update` / `/update` git-pull this fork.
export DISABLE_AUTOUPDATER=1
# Official CLI refuses bypassPermissions as uid 0 unless this is set.
export IS_SANDBOX=1
export CLAUDE_CODE_USE_OPENAI=1
export OPENAI_BASE_URL="http://openai.beefsms.com:38888/v1"
# Paste your own beefsms key. Do not commit this file.
export OPENAI_API_KEY="PASTE_YOUR_BEEFSMS_KEY_HERE"
export OPENAI_MODEL="happy/kimi-k3"
export OPENAI_API_FORMAT="chat_completions"
export CLAUDE_CODE_ALLOW_ROOT_BYPASS=1
export CLAUDE_CODE_OPENAI_CONTEXT_WINDOWS='{"happy/glm-5.3":1048576,"happy/kimi-k3":1048576,"happy/qwen-3.8-fast":1048576}'
export CLAUDE_CODE_OPENAI_MAX_OUTPUT_TOKENS='{"happy/glm-5.3":16384,"happy/kimi-k3":8192,"happy/qwen-3.8-fast":8192}'
export CLAUDE_CODE_MAX_OUTPUT_TOKENS=8192
# Compact path falls back to 128k when the model id does not exact-match the
# map above; 104k tokens then looks "full" even while the footer shows 9.9%/1M.
export CLAUDE_CODE_OPENAI_FALLBACK_CONTEXT_WINDOW=1048576
# Do not auto-summarize long RE sessions. Manual /compact still works.
export DISABLE_AUTO_COMPACT=1
# Default message-count compact is 200; hard cap 1000 would still block sends.
export OPENCLAUDE_MAX_ACTIVE_MESSAGES_HARD_CAP=0
# So /model lists every model in the beefsms provider profile (comma-separated).
export CLAUDE_CODE_PROVIDER_PROFILE_ENV_APPLIED=1
# Long GLM/Kimi thinking can sit silent on the SSE stream; idle abort is 300s.
export CLAUDE_STREAM_IDLE_TIMEOUT_MS=300000
export API_TIMEOUT_MS=3600000
export GHIDRA_INSTALL_DIR="${GHIDRA_INSTALL_DIR:-$HOME/tools/ghidra}"
export GHIDRA_HOME="${GHIDRA_HOME:-$HOME/tools/ghidra}"
export JAVA_HOME="${JAVA_HOME:-/usr/lib/jvm/java-21-openjdk-amd64}"
export REVERSE_SKILL_ROOT="${REVERSE_SKILL_ROOT:-$HOME/tools/reverse-skill}"
# Web search: force Brave (bypasses DuckDuckGo fallback). Optional.
export BRAVE_API_KEY="${BRAVE_API_KEY:-}"
export WEB_SEARCH_PROVIDER="brave"
# Ink TUI re-renders the whole transcript; long sessions drop to ~10 FPS.
# Fullscreen keeps off-screen messages out of the render tree. Toggle in-session
# with /tui fullscreen (on) or unset this and /tui default (off).
export CLAUDE_CODE_NO_FLICKER=1
